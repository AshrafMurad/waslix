  tasks        Task[]

  @@unique([workspaceId, customerId, id])
  @@unique([workspaceId, onboardingId, position])
  @@index([workspaceId, ownerId, status])
  @@map("onboarding_milestone")
}

model Renewal {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String                  @db.Uuid
  customerId            String                  @db.Uuid
  ownerId               String                  @db.Uuid
  contractValue         Decimal                 @db.Decimal(18, 2)
  currency              String                  @db.Char(3)
  startAt               DateTime?               @db.Date
  renewalAt             DateTime                @db.Date
  stage                 RenewalStage            @default(UPCOMING)
  readinessStatus       RenewalReadinessStatus?
  readinessPending      Boolean                 @default(false)
  readinessReasons      Json                    @default("[]")
  readinessCalculatedAt DateTime?               @db.Timestamptz(3)
  expectedOutcome       RenewalExpectedOutcome?
  outcome               RenewalOutcome?
  completedAt           DateTime?               @db.Timestamptz(3)
  notes                 String?                 @db.VarChar(10000)
  churnReason           String?                 @db.VarChar(10000)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  workspace             Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer              Customer                @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  owner                 WorkspaceMember         @relation("RenewalOwner", fields: [workspaceId, ownerId], references: [workspaceId, id], onDelete: Restrict)
  tasks                 Task[]

  @@unique([workspaceId, customerId, id])
  @@index([workspaceId, renewalAt])
  @@index([workspaceId, stage])
  @@index([workspaceId, ownerId, stage])
  @@map("renewal")
}

