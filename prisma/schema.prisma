generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PreferredLocale {
  EN
  AR
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ContactAccountRole {
  CHAMPION
  DECISION_MAKER
  EXECUTIVE_SPONSOR
  ADMIN
  BILLING
  USER
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  MEETING
  CALL
  EMAIL
  NOTE
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  ACHIEVED
  CANCELLED
}

enum HealthDimension {
  USAGE
  ENGAGEMENT
  SUPPORT
  GOALS
}

enum HealthStatus {
  HEALTHY
  NEEDS_ATTENTION
  AT_RISK
}

enum HealthSourceType {
  MANUAL
  SYSTEM
  INTEGRATION
}

enum HealthConfidence {
  HIGH
  MEDIUM
  LOW
}

enum SignalRuleKey {
  HEALTH_LOW
  HEALTH_DECLINE
  LOW_ENGAGEMENT
  RENEWAL_PREPARATION
  RENEWAL_DUE
  RENEWAL_RISK
  ONBOARDING_DELAY
  UNMANAGED_RISK
  RISK_UNRESOLVED
  TASK_OVERDUE
  SUPPORT_ESCALATION
  USAGE_DECLINE
  GOAL_STALLED
}

enum SignalStatus {
  ACTIVE
  RESOLVED
  EXPIRED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AttentionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum RiskType {
  USAGE
  ENGAGEMENT
  SUPPORT
  STAKEHOLDER
  ONBOARDING
  RENEWAL
  COMMERCIAL
  OTHER
}

enum RiskStatus {
  OPEN
  MONITORING
  RESOLVED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RenewalStage {
  UPCOMING
  PREPARING
  DISCUSSION
  NEGOTIATION
  COMMITTED
  RENEWED
  CHURNED
}

enum RenewalReadinessStatus {
  HEALTHY
  NEEDS_ATTENTION
  AT_RISK
}

enum RenewalExpectedOutcome {
  UNKNOWN
  RENEW
  EXPAND
  CONTRACT
  CHURN
}

enum RenewalOutcome {
  RENEWED
  EXPANDED
  CONTRACTED
  CHURNED
}

model User {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String            @unique
  emailVerified   Boolean           @default(false)
  image           String?
  preferredLocale PreferredLocale   @default(EN)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]
  memberships     WorkspaceMember[]
  invitations     Invitation[]      @relation("InvitationInviter")

  @@map("user")
}

model Session {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt         DateTime   @db.Timestamptz(3)
  token             String     @unique
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)
  ipAddress         String?
  userAgent         String?
  userId            String     @db.Uuid
  activeWorkspaceId String?    @db.Uuid
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace   Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeWorkspaceId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String                @db.VarChar(200)
  slug             String                @unique @db.VarChar(200)
  logo             String?
  metadata         String?
  timezone         String                @default("UTC") @db.VarChar(100)
  defaultCurrency  String                @default("USD") @db.Char(3)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  members          WorkspaceMember[]
  invitations      Invitation[]
  sessions         Session[]
  lifecycleStages  LifecycleStage[]
  tags             Tag[]
  customerTags     CustomerTag[]
  customers        Customer[]
  contacts         Contact[]
  tasks            Task[]
  activities       Activity[]
  systemEvents     SystemEvent[]
  jobOutbox        JobOutbox[]
  successGoals     SuccessGoal[]
  healthInputs     HealthInput[]
  healthRevisions  HealthInputRevision[]
  customerHealth   CustomerHealth[]
  healthSnapshots  HealthSnapshot[]
  signals          Signal[]
  attentionItems   AttentionItem[]
  attentionSignals AttentionSignal[]
  risks            Risk[]
  riskSignals      RiskSignal[]
  onboardings      Onboarding[]
  milestones       OnboardingMilestone[]
  renewals         Renewal[]

  @@map("workspace")
}

model WorkspaceMember {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                @db.Uuid
  userId           String                @db.Uuid
  role             String                @db.VarChar(32)
  status           MembershipStatus      @default(ACTIVE)
  joinedAt         DateTime              @default(now()) @db.Timestamptz(3)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers        Customer[]
  ownedTasks       Task[]                @relation("TaskOwner")
  createdTasks     Task[]                @relation("TaskCreator")
  completedTasks   Task[]                @relation("TaskCompleter")
  activities       Activity[]            @relation("ActivityCreator")
  systemEvents     SystemEvent[]         @relation("SystemEventActor")
  ownedGoals       SuccessGoal[]         @relation("GoalOwner")
  healthRevisions  HealthInputRevision[] @relation("HealthRevisionCreator")
  ownedRisks       Risk[]                @relation("RiskOwner")
  ownedOnboardings Onboarding[]          @relation("OnboardingOwner")
  ownedMilestones  OnboardingMilestone[] @relation("MilestoneOwner")
  ownedRenewals    Renewal[]             @relation("RenewalOwner")
  attentionActions AttentionItem[]       @relation("AttentionActor")

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId, status])
  @@map("workspace_member")
}

model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  email       String
  role        String    @db.VarChar(32)
  status      String    @db.VarChar(32)
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  inviterId   String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User      @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("invitation")
}

model LifecycleStage {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String     @db.Uuid
  name        String     @db.VarChar(200)
  key         String     @db.VarChar(50)
  position    Int
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customers   Customer[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, id])
  @@index([workspaceId, isActive, position])
  @@map("lifecycle_stage")
}

model Tag {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String        @db.Uuid
  name           String        @db.VarChar(200)
  normalizedName String        @db.VarChar(200)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customers      CustomerTag[]

  @@unique([workspaceId, normalizedName])
  @@unique([workspaceId, id])
  @@map("tag")
}

model Customer {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                @db.Uuid
  name                 String                @db.VarChar(200)
  website              String?               @db.VarChar(500)
  logoKey              String?               @db.VarChar(500)
  industry             String?               @db.VarChar(200)
  companySize          Int?
  contractValue        Decimal?              @db.Decimal(18, 2)
  currency             String                @db.Char(3)
  customerSince        DateTime?             @db.Date
  renewalDate          DateTime?             @db.Date
  lifecycleStageId     String                @db.Uuid
  ownerId              String                @db.Uuid
  status               CustomerStatus        @default(ACTIVE)
  archivedAt           DateTime?             @db.Timestamptz(3)
  externalKey          String?               @db.VarChar(200)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lifecycleStage       LifecycleStage        @relation(fields: [workspaceId, lifecycleStageId], references: [workspaceId, id], onDelete: Restrict)
  owner                WorkspaceMember       @relation(fields: [workspaceId, ownerId], references: [workspaceId, id], onDelete: Restrict)
  contacts             Contact[]
  tags                 CustomerTag[]
  tasks                Task[]
  activities           Activity[]
  systemEvents         SystemEvent[]
  jobOutbox            JobOutbox[]
  successGoals         SuccessGoal[]
  healthInputs         HealthInput[]
  currentHealth        CustomerHealth?
  healthSnapshots      HealthSnapshot[]
  healthInputRevisions HealthInputRevision[]
  signals              Signal[]
  attentionItems       AttentionItem[]
  attentionSignals     AttentionSignal[]
  risks                Risk[]
  riskSignals          RiskSignal[]
  onboarding           Onboarding?
  milestones           OnboardingMilestone[]
  renewals             Renewal[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, externalKey])
  @@index([workspaceId, status, name, id])
  @@index([workspaceId, ownerId, status])
  @@index([workspaceId, lifecycleStageId, status])
  @@map("customer")
}

model Contact {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String             @db.Uuid
  customerId        String             @db.Uuid
  name              String             @db.VarChar(200)
  email             String?            @db.VarChar(320)
  phone             String?            @db.VarChar(50)
  jobTitle          String?            @db.VarChar(200)
  accountRole       ContactAccountRole @default(OTHER)
  isPrimary         Boolean            @default(false)
  status            ContactStatus      @default(ACTIVE)
  lastInteractionAt DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  activities        Activity[]

  @@unique([workspaceId, customerId, id])
  @@index([workspaceId, customerId, status])
  @@map("contact")
}

model Task {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String               @db.Uuid
  customerId    String?              @db.Uuid
  title         String               @db.VarChar(200)
  description   String?              @db.VarChar(10000)
  ownerId       String               @db.Uuid
  createdById   String               @db.Uuid
  priority      TaskPriority         @default(MEDIUM)
  status        TaskStatus           @default(OPEN)
  dueDate       DateTime?            @db.Date
  dueAt         DateTime?            @db.Timestamptz(3)
  completedAt   DateTime?            @db.Timestamptz(3)
  completedById String?              @db.Uuid
  riskId        String?              @db.Uuid
  renewalId     String?              @db.Uuid
  milestoneId   String?              @db.Uuid
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer      Customer?            @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  owner         WorkspaceMember      @relation("TaskOwner", fields: [workspaceId, ownerId], references: [workspaceId, id], onDelete: Restrict)
  createdBy     WorkspaceMember      @relation("TaskCreator", fields: [workspaceId, createdById], references: [workspaceId, id], onDelete: Restrict)
  completedBy   WorkspaceMember?     @relation("TaskCompleter", fields: [workspaceId, completedById], references: [workspaceId, id], onDelete: Restrict)
  risk          Risk?                @relation(fields: [workspaceId, customerId, riskId], references: [workspaceId, customerId, id], onDelete: Restrict)
  renewal       Renewal?             @relation(fields: [workspaceId, customerId, renewalId], references: [workspaceId, customerId, id], onDelete: Restrict)
  milestone     OnboardingMilestone? @relation(fields: [workspaceId, customerId, milestoneId], references: [workspaceId, customerId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, ownerId, status])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, customerId])
  @@index([workspaceId, riskId, status])
  @@index([workspaceId, renewalId, status])
  @@index([workspaceId, milestoneId, status])
  @@map("task")
}

model Activity {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String          @db.Uuid
  customerId   String          @db.Uuid
  type         ActivityType
  title        String          @db.VarChar(200)
  description  String?         @db.VarChar(10000)
  contactId    String?         @db.Uuid
  createdById  String          @db.Uuid
  occurredAt   DateTime        @db.Timestamptz(3)
  isMeaningful Boolean         @default(true)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  contact      Contact?        @relation(fields: [workspaceId, customerId, contactId], references: [workspaceId, customerId, id], onDelete: Restrict)
  createdBy    WorkspaceMember @relation("ActivityCreator", fields: [workspaceId, createdById], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, customerId, id])
  @@index([workspaceId, customerId, occurredAt, id])
  @@map("activity")
}

model SuccessGoal {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String          @db.Uuid
  customerId         String          @db.Uuid
  title              String          @db.VarChar(200)
  description        String?         @db.VarChar(10000)
  ownerId            String          @db.Uuid
  progress           Int             @default(0)
  status             GoalStatus      @default(NOT_STARTED)
  targetDate         DateTime?       @db.Date
  progressObservedAt DateTime        @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?       @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer           Customer        @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  owner              WorkspaceMember @relation("GoalOwner", fields: [workspaceId, ownerId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, customerId, status])
  @@index([workspaceId, ownerId, status])
  @@map("success_goal")
}

model HealthInput {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                @db.Uuid
  customerId       String                @db.Uuid
  dimension        HealthDimension
  isManualOverride Boolean               @default(false)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer         Customer              @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  revisions        HealthInputRevision[]

  @@unique([workspaceId, customerId, dimension])
  @@unique([workspaceId, customerId, id])
  @@map("health_input")
}

model HealthInputRevision {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String           @db.Uuid
  customerId    String           @db.Uuid
  healthInputId String           @db.Uuid
  version       Int
  value         Int
  sourceType    HealthSourceType
  sourceRef     String?          @db.VarChar(500)
  isSimulated   Boolean          @default(false)
  observedAt    DateTime         @db.Timestamptz(3)
  createdById   String?          @db.Uuid
  evidence      Json?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer      Customer         @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  healthInput   HealthInput      @relation(fields: [workspaceId, customerId, healthInputId], references: [workspaceId, customerId, id], onDelete: Restrict)
  createdBy     WorkspaceMember? @relation("HealthRevisionCreator", fields: [workspaceId, createdById], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, healthInputId, version])
  @@index([workspaceId, customerId, healthInputId, version])
  @@map("health_input_revision")
}

model CustomerHealth {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String           @db.Uuid
  customerId      String           @db.Uuid
  rawScore        Decimal?         @db.Decimal(8, 4)
  overallScore    Int?
  status          HealthStatus?
  usageScore      Int?
  engagementScore Int?
  supportScore    Int?
  goalScore       Int?
  confidence      HealthConfidence @default(LOW)
  confidenceValue Decimal          @default(0) @db.Decimal(5, 4)
  calculatedAt    DateTime         @db.Timestamptz(3)
  pendingSince    DateTime?        @db.Timestamptz(3)
  calculationKey  String           @db.VarChar(500)
  ruleVersion     String           @db.VarChar(50)
  evidence        Json
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, customerId])
  @@map("customer_health")
}

model HealthSnapshot {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String           @db.Uuid
  customerId      String           @db.Uuid
  rawScore        Decimal?         @db.Decimal(8, 4)
  overallScore    Int?
  status          HealthStatus?
  usageScore      Int?
  engagementScore Int?
  supportScore    Int?
  goalScore       Int?
  confidence      HealthConfidence
  confidenceValue Decimal          @db.Decimal(5, 4)
  snapshotAt      DateTime         @db.Timestamptz(3)
  calculationKey  String           @db.VarChar(500)
  ruleVersion     String           @db.VarChar(50)
  evidence        Json
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, customerId, calculationKey])
  @@index([workspaceId, customerId, snapshotAt])
  @@map("health_snapshot")
}

model Signal {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String            @db.Uuid
  customerId      String            @db.Uuid
  type            SignalRuleKey
  ruleKey         SignalRuleKey
  ruleVersion     String            @db.VarChar(50)
  subjectKey      String            @db.VarChar(200)
  episodeKey      String            @db.Uuid
  severity        Severity
  title           String            @db.VarChar(200)
  description     String?           @db.VarChar(10000)
  currentValue    Decimal?          @db.Decimal(18, 4)
  previousValue   Decimal?          @db.Decimal(18, 4)
  sourceType      String            @db.VarChar(50)
  sourceRef       String?           @db.VarChar(500)
  isSimulated     Boolean           @default(false)
  evidence        Json
  detectedAt      DateTime          @db.Timestamptz(3)
  lastEvaluatedAt DateTime          @db.Timestamptz(3)
  status          SignalStatus      @default(ACTIVE)
  resolvedAt      DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer          @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  attentionItems  AttentionSignal[]
  risks           RiskSignal[]

  @@unique([workspaceId, customerId, id])
  @@index([workspaceId, customerId, status])
  @@index([workspaceId, customerId, ruleKey, subjectKey, status])
  @@map("signal")
}

model AttentionItem {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String            @db.Uuid
  customerId         String            @db.Uuid
  priority           Severity
  status             AttentionStatus   @default(OPEN)
  reasonSummary      String            @db.VarChar(10000)
  evidenceSignature  String            @db.VarChar(64)
  nearestDeadline    DateTime?         @db.Date
  dismissedSignature String?           @db.VarChar(64)
  dismissedPriority  Severity?
  dismissedReason    String?           @db.VarChar(10000)
  actedById          String?           @db.Uuid
  resolvedAt         DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer           Customer          @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  actedBy            WorkspaceMember?  @relation("AttentionActor", fields: [workspaceId, actedById], references: [workspaceId, id], onDelete: Restrict)
  signals            AttentionSignal[]

  @@unique([workspaceId, customerId, id])
  @@index([workspaceId, status, priority, nearestDeadline, createdAt, id])
  @@map("attention_item")
}

model AttentionSignal {
  workspaceId     String        @db.Uuid
  customerId      String        @db.Uuid
  attentionItemId String        @db.Uuid
  signalId        String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  attentionItem   AttentionItem @relation(fields: [workspaceId, customerId, attentionItemId], references: [workspaceId, customerId, id], onDelete: Restrict)
  signal          Signal        @relation(fields: [workspaceId, customerId, signalId], references: [workspaceId, customerId, id], onDelete: Restrict)

  @@id([workspaceId, attentionItemId, signalId])
  @@index([workspaceId, customerId])
  @@map("attention_signal")
}

model Risk {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String          @db.Uuid
  customerId           String          @db.Uuid
  title                String          @db.VarChar(200)
  description          String?         @db.VarChar(10000)
  type                 RiskType
  severity             Severity
  ownerId              String          @db.Uuid
  status               RiskStatus      @default(OPEN)
  targetResolutionDate DateTime?       @db.Date
  resolvedAt           DateTime?       @db.Timestamptz(3)
  resolutionNote       String?         @db.VarChar(10000)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer             Customer        @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  owner                WorkspaceMember @relation("RiskOwner", fields: [workspaceId, ownerId], references: [workspaceId, id], onDelete: Restrict)
  tasks                Task[]
  signals              RiskSignal[]

  @@unique([workspaceId, customerId, id])
  @@index([workspaceId, status, severity, targetResolutionDate, id])
  @@index([workspaceId, ownerId, status])
  @@map("risk")
}

model RiskSignal {
  workspaceId String    @db.Uuid
  customerId  String    @db.Uuid
  riskId      String    @db.Uuid
  signalId    String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  risk        Risk      @relation(fields: [workspaceId, customerId, riskId], references: [workspaceId, customerId, id], onDelete: Restrict)
  signal      Signal    @relation(fields: [workspaceId, customerId, signalId], references: [workspaceId, customerId, id], onDelete: Restrict)

  @@id([workspaceId, riskId, signalId])
  @@index([workspaceId, customerId])
  @@map("risk_signal")
}

model Onboarding {
